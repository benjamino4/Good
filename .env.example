# ===== JUST TRIBES server config =====

# Server
PORT=8080
# Comma-separated allowed origins for CORS (use your deployed frontend URL).
# Leave as * for local dev.
CORS_ORIGIN=*

# JWT signing secret — change this to a long random string in production
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES=7d

# ===== Database (Aiven PostgreSQL) =====
# Copy the "Service URI" from your Aiven PostgreSQL service overview.
# It looks like: postgres://avnadmin:PASSWORD@HOST-PORT.aivencloud.com:PORT/defaultdb?sslmode=require
DATABASE_URL=postgres://avnadmin:password@localhost:5432/defaultdb?sslmode=disable

# Aiven requires SSL. Set to 'require' for Aiven, 'disable' for local docker.
PGSSLMODE=require

# ===== Telegram =====
# From @BotFather. Used to verify Telegram Web App initData (login) securely.
# Leave EMPTY to enable DEV LOGIN (no verification) — fine for local testing only.
TELEGRAM_BOT_TOKEN=

# Secret token you pass to setWebhook (secret_token=...) so only Telegram can
# call /api/telegram/webhook. Telegram echoes it in the
# X-Telegram-Bot-Api-Secret-Token header. Leave empty in dev.
TELEGRAM_WEBHOOK_SECRET=

# ===== Payments (Telegram Stars) =====
# Star packs are purchased with real Telegram Stars (currency XTR) via
# createInvoiceLink + WebApp.openInvoice. No provider token is needed for Stars.
# Set to 1 to allow the /api/payments/dev-credit test path even when a bot token
# is configured. Auto-enabled when TELEGRAM_BOT_TOKEN is empty.
ALLOW_DEV_PAYMENTS=0

# Public HTTPS origin of THIS server (used for the TON Connect manifest URL and
# webhook registration), e.g. https://just-tribes.onrender.com
PUBLIC_URL=

# ===== TON wallet (TON Connect) =====
# The front-end loads its TON Connect manifest from /tonconnect-manifest.json,
# which is generated from PUBLIC_URL at runtime. Just set PUBLIC_URL above to
# your deployed HTTPS origin and the wallet section works (TON Space, Tonkeeper,
# Wallet-in-Telegram, MetaMask via TON Connect).

# ===== Admin panel (separate admin bot + web mini app at /admin) =====
# The admin panel is launched by a SECOND Telegram bot as its own mini app and
# is protected by this username/password. Leave BOTH empty to disable admin.
ADMIN_USER=
ADMIN_PASS=
# Token of the SEPARATE admin bot (from @BotFather). When set, the admin login
# also verifies the panel was opened from this bot (initData signature).
ADMIN_BOT_TOKEN=
# Separate signing secret for admin sessions (defaults to JWT_SECRET+':admin').
ADMIN_JWT_SECRET=
ADMIN_JWT_EXPIRES=12h

# ===== Game economy tuning (INITIAL defaults only) =====
# NOTE: economy is now stored in the DB and fully editable from the admin panel.
# These env values are no longer read at runtime once the config is seeded.
CHECKIN_EMBER=120
LOYALTY_TITHE=0.20
DEFAULT_MEMBER_LIMIT=25
